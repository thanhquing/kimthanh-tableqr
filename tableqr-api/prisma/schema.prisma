generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SessionStatus {
  OPEN
  CLOSED
}

enum OrderStatus {
  NEW
  PREPARING
  SERVED
  CANCELLED
}

enum StaffCallType {
  CALL_STAFF
  REQUEST_BILL
}

enum StaffCallStatus {
  PENDING
  DONE
}

enum UserRole {
  STAFF
  OWNER
}

enum BillingStatus {
  TRIAL
  ACTIVE
  GRACE
  PAST_DUE
  SUSPENDED
}

enum PlanInterval {
  MONTHLY
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  GRACE
  PAST_DUE
  SUSPENDED
}

enum SubscriptionCycleStatus {
  PENDING
  PAID
  VOID
}

enum SubscriptionEventType {
  GRACE_STARTED
  DUNNING_NOTICE
  PAST_DUE
  ACTIVATED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Restaurant {
  id             String              @id @default(uuid()) @db.Uuid
  name           String
  publicSlug     String              @unique @map("public_slug")
  staffLoginCode String              @unique @map("staff_login_code")
  logoUrl        String?             @map("logo_url")
  address        String?
  trialEndsAt    DateTime            @map("trial_ends_at") @db.Timestamptz(3)
  billingStatus  BillingStatus       @default(TRIAL) @map("billing_status")
  authUsers      AuthUser[]
  tables         DiningTable[]
  categories     MenuCategory[]
  menuItems      MenuItem[]
  sessions       TableSession[]
  orders         Order[]
  guestRequests  GuestOrderRequest[]
  guestAccesses  GuestSessionAccess[]
  orderItems     OrderItem[]
  calls          StaffCall[]
  staffDevicePairings StaffDevicePairing[]
  subscriptions  Subscription[]
  subscriptionCycles SubscriptionCycle[]
  subscriptionEvents SubscriptionEvent[]
  payments       Payment[]
  paymentWebhookEvents PaymentWebhookEvent[]

  @@map("restaurant")
}

model Plan {
  id            String         @id @default(uuid()) @db.Uuid
  code          String         @unique
  name          String
  priceVnd      Int            @map("price_vnd")
  interval      PlanInterval
  featureLimits Json           @map("feature_limits")
  isActive      Boolean        @default(true) @map("is_active")
  subscriptions Subscription[]
  @@map("plan")
}

model Subscription {
  id                    String             @id @default(uuid()) @db.Uuid
  restaurantId          String             @unique @map("restaurant_id") @db.Uuid
  planId                String             @map("plan_id") @db.Uuid
  status                SubscriptionStatus @default(TRIAL)
  trialEndsAt           DateTime           @map("trial_ends_at") @db.Timestamptz(3)
  graceEndsAt           DateTime?          @map("grace_ends_at") @db.Timestamptz(3)
  currentPeriodStartsAt DateTime?          @map("current_period_starts_at") @db.Timestamptz(3)
  currentPeriodEndsAt   DateTime?          @map("current_period_ends_at") @db.Timestamptz(3)
  priceVndSnapshot      Int                @map("price_vnd_snapshot")
  featureLimitsSnapshot Json               @map("feature_limits_snapshot")
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  restaurant            Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  plan                  Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  cycles                SubscriptionCycle[]
  events                SubscriptionEvent[]
  @@unique([restaurantId, id], map: "subscription_restaurant_id_id_key")
  @@map("subscription")
}

// Audit lifecycle: bat dau grace, nhac gia han ngay 1/3/7 va thoi diem qua han.
// `occurredAt` la moc suy ra tu `graceEndsAt` (khong phai luc chay), nen unique
// key vua chong ghi trung vua tach duoc cac ky grace khac nhau.
model SubscriptionEvent {
  id             String                @id @default(uuid()) @db.Uuid
  restaurantId   String                @map("restaurant_id") @db.Uuid
  subscriptionId String                @map("subscription_id") @db.Uuid
  type           SubscriptionEventType
  dunningDay     Int                   @default(0) @map("dunning_day")
  occurredAt     DateTime              @map("occurred_at") @db.Timestamptz(3)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  restaurant     Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  subscription   Subscription          @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  @@unique([subscriptionId, type, dunningDay, occurredAt], map: "subscription_event_occurrence_key")
  @@index([restaurantId, occurredAt], map: "subscription_event_restaurant_occurred_at_idx")
  @@map("subscription_event")
}

model SubscriptionCycle {
  id             String                  @id @default(uuid()) @db.Uuid
  restaurantId   String                  @map("restaurant_id") @db.Uuid
  subscriptionId String                  @map("subscription_id") @db.Uuid
  sequenceNo     Int                     @map("sequence_no")
  status         SubscriptionCycleStatus @default(PENDING)
  amountVnd      Int                     @map("amount_vnd")
  periodStartsAt DateTime                @map("period_starts_at") @db.Timestamptz(3)
  periodEndsAt   DateTime                @map("period_ends_at") @db.Timestamptz(3)
  dueAt          DateTime                @map("due_at") @db.Timestamptz(3)
  paidAt         DateTime?               @map("paid_at") @db.Timestamptz(3)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  restaurant     Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  subscription   Subscription            @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  payments       Payment[]
  @@unique([subscriptionId, sequenceNo], map: "subscription_cycle_subscription_sequence_no_key")
  @@index([restaurantId, status, dueAt], map: "subscription_cycle_restaurant_status_due_at_idx")
  @@map("subscription_cycle")
}

model Payment {
  id                  String        @id @default(uuid()) @db.Uuid
  restaurantId        String        @map("restaurant_id") @db.Uuid
  subscriptionCycleId String        @map("subscription_cycle_id") @db.Uuid
  provider            String
  paymentCode         String        @unique @map("payment_code")
  providerTransactionId String?     @unique @map("provider_transaction_id")
  amountVnd           Int           @map("amount_vnd")
  status              PaymentStatus @default(PENDING)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  paidAt              DateTime?     @map("paid_at") @db.Timestamptz(3)
  restaurant          Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  subscriptionCycle   SubscriptionCycle @relation(fields: [subscriptionCycleId], references: [id], onDelete: Restrict)
  @@index([restaurantId, status], map: "payment_restaurant_status_idx")
  @@map("payment")
}

model PaymentWebhookEvent {
  id              String   @id @default(uuid()) @db.Uuid
  restaurantId    String   @map("restaurant_id") @db.Uuid
  provider        String
  providerEventId String   @map("provider_event_id")
  payload         Json
  receivedAt      DateTime @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(3)
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  @@unique([provider, providerEventId], map: "payment_webhook_event_provider_event_id_key")
  @@index([restaurantId, receivedAt], map: "payment_webhook_event_restaurant_received_at_idx")
  @@map("payment_webhook_event")
}

model AuthUser {
  id           String   @id @default(uuid()) @db.Uuid
  role         UserRole
  email        String?  @unique
  pinHash      String?  @map("pin_hash")
  passwordHash String?  @map("password_hash")
  displayName  String   @map("display_name")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  restaurantId String   @map("restaurant_id") @db.Uuid
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([role, isActive], map: "auth_user_role_is_active_idx")
  @@index([restaurantId, role, isActive], map: "auth_user_restaurant_role_is_active_idx")
  @@map("auth_user")
}

model StaffDevicePairing {
  id           String     @id @default(uuid()) @db.Uuid
  restaurantId String     @map("restaurant_id") @db.Uuid
  tokenHash    String     @unique @map("token_hash")
  expiresAt    DateTime   @map("expires_at") @db.Timestamptz(3)
  claimedAt    DateTime?  @map("claimed_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, expiresAt], map: "staff_device_pairing_restaurant_expires_at_idx")
  @@map("staff_device_pairing")
}

model DiningTable {
  id          String         @id @default(uuid()) @db.Uuid
  restaurantId String        @map("restaurant_id") @db.Uuid
  code        String
  displayName String         @map("display_name")
  qrToken     String         @unique @map("qr_token")
  isActive    Boolean        @default(true) @map("is_active")
  sortOrder   Int            @default(0) @map("sort_order")
  sessions    TableSession[]
  orders      Order[]
  calls       StaffCall[]
  restaurant  Restaurant     @relation(fields: [restaurantId], references: [id])

  @@unique([restaurantId, code], map: "dining_table_restaurant_id_code_key")
  @@unique([restaurantId, id], map: "dining_table_restaurant_id_id_key")
  @@index([restaurantId, sortOrder], map: "dining_table_restaurant_id_sort_order_idx")
  @@map("dining_table")
}

model MenuCategory {
  id        String     @id @default(uuid()) @db.Uuid
  restaurantId String  @map("restaurant_id") @db.Uuid
  name      String
  sortOrder Int        @default(0) @map("sort_order")
  isActive  Boolean    @default(true) @map("is_active")
  items     MenuItem[]
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId, sortOrder], map: "menu_category_restaurant_id_sort_order_idx")
  @@unique([restaurantId, id], map: "menu_category_restaurant_id_id_key")
  @@map("menu_category")
}

model MenuItem {
  id          String       @id @default(uuid()) @db.Uuid
  restaurantId String      @map("restaurant_id") @db.Uuid
  categoryId  String       @map("category_id") @db.Uuid
  name        String
  description String?
  priceVnd    Int          @map("price_vnd")
  imageUrl    String?      @map("image_url")
  isAvailable Boolean      @default(true) @map("is_available")
  sortOrder   Int          @default(0) @map("sort_order")
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamptz(3)
  category    MenuCategory @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  restaurant  Restaurant   @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId, categoryId, sortOrder], map: "menu_item_restaurant_category_sort_order_idx")
  @@index([restaurantId, sortOrder], map: "menu_item_restaurant_sort_order_idx")
  @@unique([restaurantId, id], map: "menu_item_restaurant_id_id_key")
  @@map("menu_item")
}

model TableSession {
  id       String        @id @default(uuid()) @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  tableId  String        @map("table_id") @db.Uuid
  openedAt DateTime      @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedAt DateTime?     @map("closed_at") @db.Timestamptz(3)
  status   SessionStatus @default(OPEN)
  paidAt   DateTime?     @map("paid_at") @db.Timestamptz(3)
  table    DiningTable   @relation(fields: [tableId], references: [id])
  orders   Order[]
  calls    StaffCall[]
  restaurant Restaurant  @relation(fields: [restaurantId], references: [id])
  guestAccesses GuestSessionAccess[]

  @@index([restaurantId, tableId, status], map: "table_session_restaurant_table_status_idx")
  @@unique([restaurantId, id], map: "table_session_restaurant_id_id_key")
  @@map("table_session")
}

model GuestSessionAccess {
  id        String       @id @default(uuid()) @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  sessionId String       @map("session_id") @db.Uuid
  tokenHash String       @unique @map("token_hash")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  session   TableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  restaurant Restaurant  @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId, sessionId], map: "guest_session_access_restaurant_session_id_idx")
  @@index([sessionId], map: "guest_session_access_session_id_idx")
  @@map("guest_session_access")
}

model Order {
  id         String       @id @default(uuid()) @db.Uuid
  restaurantId String     @map("restaurant_id") @db.Uuid
  sessionId  String       @map("session_id") @db.Uuid
  tableId    String       @map("table_id") @db.Uuid
  sequenceNo Int          @map("sequence_no")
  status     OrderStatus  @default(NEW)
  note       String?
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  session    TableSession @relation(fields: [sessionId], references: [id])
  table      DiningTable  @relation(fields: [tableId], references: [id])
  items      OrderItem[]
  request    GuestOrderRequest?
  restaurant Restaurant   @relation(fields: [restaurantId], references: [id])

  @@unique([restaurantId, sessionId, sequenceNo], map: "order_restaurant_session_sequence_no_key")
  @@index([restaurantId, createdAt], map: "order_restaurant_created_at_idx")
  @@index([restaurantId, status, createdAt], map: "order_restaurant_status_created_at_idx")
  @@index([restaurantId, tableId], map: "order_restaurant_table_id_idx")
  @@unique([restaurantId, id], map: "order_restaurant_id_id_key")
  @@map("order")
}

model GuestOrderRequest {
  id        String   @id @default(uuid()) @db.Uuid
  restaurantId String @map("restaurant_id") @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  requestId String   @map("request_id")
  orderId   String   @unique @map("order_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  order     Order    @relation(fields: [orderId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@unique([restaurantId, sessionId, requestId], map: "guest_order_request_restaurant_session_request_id_key")
  @@index([restaurantId, createdAt], map: "guest_order_request_restaurant_created_at_idx")
  @@map("guest_order_request")
}

model OrderItem {
  id                   String   @id @default(uuid()) @db.Uuid
  restaurantId         String   @map("restaurant_id") @db.Uuid
  orderId              String   @map("order_id") @db.Uuid
  menuItemId           String   @map("menu_item_id") @db.Uuid
  nameSnapshot         String   @map("name_snapshot")
  unitPriceVndSnapshot Int      @map("unit_price_vnd_snapshot")
  quantity             Int
  note                 String?
  order                Order    @relation(fields: [orderId], references: [id])
  menuItem             MenuItem @relation(fields: [menuItemId], references: [id])
  restaurant           Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId, orderId], map: "order_item_restaurant_order_id_idx")
  @@index([restaurantId, menuItemId], map: "order_item_restaurant_menu_item_id_idx")
  @@map("order_item")
}

model StaffCall {
  id        String          @id @default(uuid()) @db.Uuid
  restaurantId String       @map("restaurant_id") @db.Uuid
  sessionId String          @map("session_id") @db.Uuid
  tableId   String          @map("table_id") @db.Uuid
  type      StaffCallType
  status    StaffCallStatus @default(PENDING)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  session   TableSession    @relation(fields: [sessionId], references: [id])
  table     DiningTable     @relation(fields: [tableId], references: [id])
  restaurant Restaurant     @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId, status, createdAt], map: "staff_call_restaurant_status_created_at_idx")
  @@index([restaurantId, sessionId], map: "staff_call_restaurant_session_id_idx")
  @@map("staff_call")
}
