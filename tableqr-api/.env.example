# Runtime API phai SET ROLE tableqr_app de PostgreSQL RLS co hieu luc. Lanh
# migrate/seed dung DATABASE_ADMIN_URL (owner), khong dung URL nay.
DATABASE_URL="postgresql://tableqr:tableqr@localhost:5433/tableqr?schema=public&options=-c%20role=tableqr_app"
DATABASE_ADMIN_URL="postgresql://tableqr:tableqr@localhost:5433/tableqr?schema=public"
PORT=3000
UPLOAD_DIR="./uploads"
JWT_SECRET="thay-chuoi-bi-mat-nay-truoc-khi-deploy"
# SA-09: chỉ server dùng secret này để xác thực webhook SePay, không commit giá trị thật.
SEPAY_WEBHOOK_SECRET=""
SEPAY_PAYMENT_CODE_PREFIX="TQR"
SEPAY_BANK_NAME=""
SEPAY_BANK_ACCOUNT=""
# Production cần DATABASE_URL, UPLOAD_DIR, GUEST_BASE_URL, STAFF_BASE_URL và
# JWT_SECRET riêng dài ít nhất 32 ký tự. Xem infra/production/.
