# DNS của cả ba hostname phải trỏ về host trước lần chạy Caddy đầu tiên.
ADMIN_HOST=tableqr.vn
STAFF_HOST=staff.tableqr.vn
GUEST_HOST=guest.tableqr.vn
ACME_EMAIL=owner@example.com

# Sinh secret production riêng, ví dụ:
# openssl rand -base64 48
JWT_SECRET=replace-with-a-unique-secret-of-at-least-32-characters

# Dùng mật khẩu dài, riêng biệt. Không dùng lại credentials development local.
POSTGRES_DB=tableqr
POSTGRES_USER=tableqr
POSTGRES_PASSWORD=replace-with-a-long-unique-database-password
