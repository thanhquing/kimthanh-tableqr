{
	email {$ACME_EMAIL}
}

(api) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	@api path /api/v1/* /uploads/* /menu-images/*
	handle @api {
		reverse_proxy api:3000
	}
}

(spa) {
	try_files {path} /index.html
	file_server
}

https://{$ADMIN_HOST} {
	import api
	root * /srv/admin
	import spa
}

https://{$STAFF_HOST} {
	import api
	root * /srv/staff
	import spa
}

https://{$GUEST_HOST} {
	import api
	root * /srv/guest
	import spa
}
