{
  "name": "tableqr-guest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run prepare:mock && vite --port 5173 --strictPort",
    "prepare:mock": "msw init public --save",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview --port 5173 --strictPort",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@kimthanh-tableqr/contracts": "workspace:*",
    "@kimthanh-tableqr/mock": "workspace:*",
    "@kimthanh-tableqr/ui": "workspace:*",
    "@tanstack/react-query": "^5.66.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "msw": "^2.7.0",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.19.1",
    "vite": "^5.4.14"
  },
  "msw": {
    "workerDirectory": ["public"]
  }
}
